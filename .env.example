# Environment variables read by the web image (both roles). Placeholders only: never put real
# values in this file or in git. Secrets are NOT environment variables: each container reads them
# from files in the directory named by GRADER_SECRETS_DIR (see docs/ARCHITECTURE.md, "Secrets").
#
# For local development you don't need any of these: ./init.sh creates .devdata/, and the
# settings fill in dev defaults from it.

# Which site this container serves: "public" (practice site) or "admin" (Django admin + judge API).
GRADER_ROLE=public

# The address people use to reach each role. Only that host name is accepted.
PUBLIC_BASE_URL=https://grader.example.com
ADMIN_BASE_URL=http://192.0.2.10:8081

# Directory holding the secret files django_secret_key and db_password.
GRADER_SECRETS_DIR=/run/secrets/web
# Admin role only: the worker's secret directory, for the worker_token file.
GRADER_WORKER_SECRETS_DIR=/run/secrets/worker

# The problem store (read-only in the public role).
GRADER_PROBLEMS_DIR=/data/problems

# The site name shown in the page header, in Thai and in English.
SITE_NAME_TH=เกรดเดอร์
SITE_NAME_EN=Grader

# Google sign-in endpoints. Leave unset in production: the defaults are Google's sign-in page
# and the edge's :8090 listener. The dev stack points them at its fake provider.
# GRADER_GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# GRADER_GOOGLE_TOKEN_URL=http://edge:8090/token
# GRADER_GOOGLE_JWKS_URL=http://edge:8090/certs
# GRADER_GOOGLE_ISSUERS=https://accounts.google.com,accounts.google.com

# Host name of the Postgres server.
GRADER_DB_HOST=db

TZ=Asia/Bangkok
