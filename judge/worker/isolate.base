# Base isolate configuration for the grader's judge, baked into the worker image. At start-up
# grader_worker.setup copies it to /usr/local/etc/isolate and adds one box1NN.cpus line per slot.
# It uses its own namespace so it never collides with another isolate (such as CMS's) on the
# same host: its own cgroup subtree, its own UID/GID range, and box ids 100-109.

# Boxes live on disk, not tmpfs (tmpfs pages would count toward a box's memory).
box_root = /var/local/lib/isolate
lock_root = /run/isolate/locks

# Created and prepared by the worker entrypoint.
cg_root = /sys/fs/cgroup/grader-judge

first_uid = 70000
first_gid = 70000
num_boxes = 110

# Only root (the worker) may create boxes.
restricted_init = 1
